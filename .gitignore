.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.env
.env.*
!.env.example
.DS_Store

# Local datasets and generated outputs
/data/*
!/data/.gitkeep
/artifacts/*
!/artifacts/.gitkeep
*.pt
*.pth
*.ckpt
*.safetensors

# Local agent state
.claude/settings.local.json
.codex/config.toml

# CIFAR-100 speedrun (cifar100-speedrun/.gitignore also covers its own .venv, data/, results/)
cifar100-speedrun/.venv/
cifar100-speedrun/data/
cifar100-speedrun/results/*
!cifar100-speedrun/results/.gitkeep
cifar-100-python/
cifar-100-python.tar.gz
# Keep run records (summary.json, trials.jsonl, config.json, LOG.md), not the copied source trees
!/artifacts/speedrun_runs/
/artifacts/speedrun_runs/**/source/
# Modal credentials live in ~/.modal.toml, never in the repo
.modal.toml
